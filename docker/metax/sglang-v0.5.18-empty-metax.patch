diff --git a/python/sglang/kernels/ops/attention/fla/utils.py b/python/sglang/kernels/ops/attention/fla/utils.py
index 4154a3c..b992c0f 100644
--- a/python/sglang/kernels/ops/attention/fla/utils.py
+++ b/python/sglang/kernels/ops/attention/fla/utils.py
@@ -262,6 +262,11 @@ def _check_platform() -> Literal["nvidia", "amd", "intel", "musa"]:
 # However, the torch backend is 'cuda' for both Nvidia and AMD GPUs.
 # Therefore, we need to check the triton backend to determine the actual GPU vendor.
 device = get_available_device() if get_available_device() != "hip" else "cuda"
+# Out-of-tree triton backends (e.g. 'maca' from FlagTree on MetaX) may report a
+# backend name that has no matching torch device module, while the vendor torch
+# still exposes the device through the CUDA-compatible ``torch.cuda`` API.
+if device != "cpu" and not hasattr(torch, device):
+    device = "cuda"
 device_torch_lib = getattr(torch, device)
 device_platform = _check_platform()
 
diff --git a/python/sglang/srt/utils/common.py b/python/sglang/srt/utils/common.py
index 053f2cd..2abbf56 100644
--- a/python/sglang/srt/utils/common.py
+++ b/python/sglang/srt/utils/common.py
@@ -148,12 +148,30 @@ builtins.FP8_E4M3_MIN = FP8_E4M3_MIN
 
 @lru_cache(maxsize=1)
 def is_cuda():
-    return torch.cuda.is_available() and torch.version.cuda is not None
+    if not (torch.cuda.is_available() and torch.version.cuda is not None):
+        return False
+    # Some OOT platforms (e.g. MetaX) ship a CUDA-compatible torch that reports
+    # ``torch.version.cuda`` but cannot run NVIDIA kernels (sgl_kernel, flashinfer).
+    # Let the registered OOT platform decide whether this is real NVIDIA CUDA.
+    from sglang.srt.platforms import current_platform
+
+    if current_platform.is_out_of_tree():
+        return current_platform.is_cuda()
+    return True
 
 
 @lru_cache(maxsize=1)
 def is_cuda_alike():
-    return is_cuda() or is_hip()
+    if is_cuda() or is_hip():
+        return True
+    # OOT platforms with a CUDA-compatible torch API (e.g. MetaX) are CUDA-alike
+    # even though they cannot run NVIDIA kernels.
+    if torch.cuda.is_available() and torch.version.cuda is not None:
+        from sglang.srt.platforms import current_platform
+
+        if current_platform.is_out_of_tree():
+            return current_platform.is_cuda_alike()
+    return False
 
 
