# CI image for sglang-plugin-FL on Enflame GCU (S60, torch_gcu).
#
# Thin layer on top of the FlagOS enflame release image (flagrelease-built):
# the vendor stack — topsrider 1.9.29 userspace, torch 2.11.0+cpu +
# torch_gcu 2.11.0+3.8.20260713, triton 3.6.0 (GCU backend), vllm 0.20.2 —
# is proprietary to Enflame and NOT installable from public PyPI, so we FROM
# the release image (digest-pinned) and only add what the sglang plugin CI
# needs: sglang 0.5.11 (stock PyPI wheel, --no-deps so the GCU torch stack is
# never touched), its pure-python runtime deps, the ShareGPT dataset bake,
# and pytest/dev tooling. The base image's GCU-tuned FlagGems is kept (see
# the FLAGGEMS_VERSION note below).
#
# Verified stack inside the base image (inspected 2026-08-19):
#   ubuntu:24.04 · python 3.12.8 · torch 2.11.0+cpu · torch_gcu 2.11.0+3.8.20260713
#   · vllm 0.20.2 · flag_gems 5.4.0.dev589+ga96298230 · triton 3.6.0
#   · transformers 5.8.1 · vllm_fl at /root/sources/vllm-plugin-FL
# NOTE: the base image is vLLM-oriented (its plugin0.2.0 = vllm-plugin-FL).
# The stale vllm_fl source tree registers only vllm.* entry points, so it is
# inert for sglang; it is kept because removing it buys nothing.
# NOTE: torch.cuda.is NOT available on GCU (torch 2.11.0+cpu + torch_gcu);
# the device module is torch.gcu. FlagGems DeviceDetector reports
# vendor=enflame / device=gcu / dispatch_key=PrivateUse1.
#
# GCU device access: no enflame container runtime exists; the char devices
# (/dev/gcuctl + /dev/gcu7vid0..N) are passed via --device in
# .github/configs/enflame.yml, and the TORCH_GCU_* env vars are set there.
#
# Build (the host needs to reach github.com + pypi.org + huggingface.co):
#   docker build -t harbor.baai.ac.cn/flagos-dev/sglang-plugin-fl:0.2.0-enflame-ci \
#     --build-arg http_proxy=$http_proxy --build-arg https_proxy=$https_proxy \
#     -f docker/enflame/containerfile .
#
# Push target: harbor.baai.ac.cn/flagos-dev/sglang-plugin-fl:0.2.0-enflame-ci

# Digest-pinned (tag 202607221058 is timestamped; the digest is immutable).
ARG BASE_IMAGE=harbor.baai.ac.cn/plugin/enflame001-gems5.4.0-treenone-triton3.6.0-cxnone-plugin0.2.0-vllm0.20.2-cp312-pt211-x64-1.9.29@sha256:adc69cc22545518759b1dc762a19204adfaa27311d5caa3d3074bb9ee443d970

# Pre-baked ShareGPT HF cache (see the "Offline benchmark dataset bake"
# section at the bottom for why this is copied instead of downloaded).
FROM harbor.baai.ac.cn/flagos-dev/sglang-plugin-fl:0.2.0-cuda-ci AS hf-cache

FROM ${BASE_IMAGE}

# Proxy is passed at build time only (--build-arg); declared as ARG so the
# sglang/FlagGems/ShareGPT steps can reach the public internet, but it is NOT
# persisted into the final image.
ARG http_proxy
ARG https_proxy
ARG no_proxy

# sglang version (repo baseline; matches docker/cuda/containerfile).
ARG SGLANG_VERSION=0.5.11
# FlagGems version. The base image ships 5.4.0.dev589+ga96298230, curated by
# flagrelease specifically for GCU — and it MUST be kept: FlagGems v5.3.0 was
# tried and its GCU `index` op generates broken code_cache wrappers
# (NameError: _has_strided_buffer undefined, hits sglang's overlap-utils
# token-id resolution immediately). Aligning GCU to the v5.3.x repo baseline
# needs an upstream FlagGems fix first. Set FLAGGEMS_VERSION to a tag to
# override (build-time experiment knob).
ARG FLAGGEMS_VERSION=
# Optional HTTP proxy for the git clone below ONLY (pip must stay direct —
# the CI proxy does not carry pypi.org). Passed via --build-arg GIT_PROXY=...
ARG GIT_PROXY=

ENV DEBIAN_FRONTEND=noninteractive \
    HF_ENDPOINT=https://huggingface.co \
    SGLANG_FL_PLATFORM=enflame \
    SGLANG_FL_DIST_BACKEND=eccl \
    SGLANG_FL_FLAGOS_BLACKLIST=scaled_dot_product_attention,cumsum,cumsum_out,count_nonzero,unique,_unique2

# ---------------------------------------------------------------------------
# SGLang (stock wheel, dependency-free install)
# ---------------------------------------------------------------------------
# sglang[runtime]'s dep set would pull the CUDA torch/flashinfer/sgl-kernel
# stack and destroy the GCU environment, so sglang itself is installed
# --no-deps and only the pure-python subset it imports at runtime is added
# explicitly. torch/triton/transformers/numpy already come from the base.
RUN pip install --no-cache-dir --no-deps "sglang==${SGLANG_VERSION}" && \
    pip install --no-cache-dir \
        aiohttp \
        anthropic \
        blobfile==3.0.0 \
        compressed-tensors \
        datasets \
        easydict \
        einops \
        fastapi \
        gguf \
        interegular \
        IPython \
        "llguidance>=0.7.11,<0.8.0" \
        modelscope \
        msgspec \
        ninja \
        nvidia-ml-py \
        openai==2.6.1 \
        openai-harmony==0.0.4 \
        orjson \
        outlines==0.1.11 \
        packaging \
        partial_json_parser \
        pillow \
        "prometheus-client>=0.20.0" \
        psutil \
        py-spy \
        pybase64 \
        pydantic \
        python-multipart \
        "pyzmq>=25.1.2" \
        requests \
        scipy \
        tornado \
        tqdm \
        uvicorn \
        xgrammar \
        zstandard

# ---------------------------------------------------------------------------
# In-image sglang source patches
# ---------------------------------------------------------------------------
# Deterministic seds against the pinned sglang==${SGLANG_VERSION} install.
# These are IMAGE-level patches (the repo's plugin code is NOT modified); each
# is guarded by a trailing grep so the build fails loudly if a future sglang
# bump changes the patched lines.
# 1) configs/device_config.py: SUPPORTED_DEVICES is a hardcoded whitelist with
#    no extension hook — add "gcu" so ServerArgs(device="gcu") is accepted.
# 2) layers/logits_processor.py: torch.cumsum(extend_seq_lens) relies on
#    CUDA's implicit int32->int64 promotion; topsatenCumsum hard-aborts on the
#    dtype mismatch ("output tensor's data type must match the input"), so the
#    input is cast explicitly (semantically identical on CUDA).
# NOTE: the sglang path is hardcoded (not resolved via `import sglang.srt`)
# because the build sandbox has NO GCU devices — importing sglang.srt in the
# base image transitively loads vllm_fl -> torch_gcu, which hard-aborts when
# the GCU probe finds no hardware. The path is stable for the digest-pinned
# base (python 3.12).
RUN SRT="/usr/local/lib/python3.12/site-packages/sglang/srt" && \
    sed -i 's/SUPPORTED_DEVICES = \["cuda", "xpu", "hpu", "cpu", "npu", "musa", "mps"\]/SUPPORTED_DEVICES = ["cuda", "xpu", "hpu", "cpu", "npu", "musa", "mps", "gcu"]/' \
        "${SRT}/configs/device_config.py" && \
    sed -i 's/last_index = torch.cumsum(logits_metadata.extend_seq_lens, dim=0) - 1/last_index = torch.cumsum(logits_metadata.extend_seq_lens.to(torch.int64), dim=0) - 1/' \
        "${SRT}/layers/logits_processor.py" && \
    grep -q '"gcu"' "${SRT}/configs/device_config.py" && \
    grep -q 'extend_seq_lens.to(torch.int64)' "${SRT}/layers/logits_processor.py"

# ---------------------------------------------------------------------------
# sgl_kernel import-time stub
# ---------------------------------------------------------------------------
# sglang 0.5.11 imports a few sgl_kernel symbols at module level
# (mem_cache/memory_pool_host.py -> sgl_kernel.kvcacheio, ...) even on
# devices without a CUDA sgl-kernel build. The kernels are never executed on
# GCU — the plugin's dispatch layer routes fused kernels to flagos/vendor/
# reference — so an import-safe stub that raises loudly on any actual call
# is installed instead of the CUDA wheel. See docker/enflame/sgl_kernel_stub/.
COPY docker/enflame/sgl_kernel_stub /tmp/sgl_kernel_stub
RUN pip install --no-cache-dir /tmp/sgl_kernel_stub && rm -rf /tmp/sgl_kernel_stub

# ---------------------------------------------------------------------------
# FlagGems override (optional, disabled by default)
# ---------------------------------------------------------------------------
# Only runs when FLAGGEMS_VERSION is set. v5.3.x builds with scikit-build-core
# (unlike the setuptools-based v5.3.1), so cmake/ninja/pybind11 are staged
# first. SETUPTOOLS_SCM_PRETEND_VERSION avoids setuptools-scm git-describe
# issues in the --depth 1 clone.
RUN if [ -n "${FLAGGEMS_VERSION}" ]; then \
        pip install --no-cache-dir -U "setuptools<77" "setuptools-scm>=8,<10" \
            scikit-build-core pybind11 ninja cmake wheel && \
        git -c http.proxy=${GIT_PROXY} clone --branch ${FLAGGEMS_VERSION} --depth 1 \
            https://github.com/flagos-ai/FlagGems /tmp/FlagGems && \
        SETUPTOOLS_SCM_PRETEND_VERSION=${FLAGGEMS_VERSION#v} \
        pip install --no-build-isolation --no-deps /tmp/FlagGems && \
        rm -rf /tmp/FlagGems; \
    fi

# ---------------------------------------------------------------------------
# Test & dev tools (mirrors docker/cuda/containerfile)
# ---------------------------------------------------------------------------
RUN pip install --no-cache-dir \
        pytest \
        pytest-cov \
        pytest-timeout \
        pytest-json-report \
        pytest-metadata \
        numpy \
        requests \
        ruff \
        pyyaml

# ---------------------------------------------------------------------------
# Offline benchmark dataset bake
# ---------------------------------------------------------------------------
# sglang's benchmark (bench_offline_throughput / bench_serving) fetches the
# 642 MB ShareGPT dataset from HF even under --dataset-name random. The build
# sandbox cannot reach huggingface.co (and hf-mirror.com 302s break
# huggingface_hub metadata), so the pinned HF cache is copied from the CUDA
# CI image on harbor (which baked it at build time; see
# docker/cuda/containerfile). HF_HOME is pinned because the runner overrides
# HOME=/github/home at runtime.
COPY --from=hf-cache /opt/hf-cache /opt/hf-cache
ENV HF_HOME=/opt/hf-cache
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

WORKDIR /workspace
