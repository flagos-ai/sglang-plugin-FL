ARG SGLANG_BASE_IMAGE=lmsysorg/sglang:v0.5.18-runtime
FROM ${SGLANG_BASE_IMAGE} AS runtime

ARG FLAGTREE_VERSION=0.6.2a1
ARG FLAGTREE_INDEX=https://resource.flagos.net/repository/flagos-pypi-hosted/simple
ARG PYPI_INDEX=https://resource.flagos.net/repository/pypi-proxy/simple

# The official runtime image owns the complete SGLang 0.5.18 CUDA stack:
# Python 3.12, PyTorch 2.13.0+cu130, sglang-kernel 0.4.6.post1,
# FlashInfer 0.6.17, transformers 5.12.1, and xgrammar 0.2.1. Do not
# re-resolve those dependencies here.

# Replace the standalone Triton distribution installed by PyTorch with
# FlagTree, which supplies the Triton 3.6-compatible `triton` module. Keep
# this after the SGLang installation because dependency resolution may install
# the standalone distribution again.
RUN while python3 -m pip show triton >/dev/null 2>&1; do \
        python3 -m pip uninstall -y triton; \
    done && \
    python3 -m pip install --no-cache-dir \
        --index-url ${FLAGTREE_INDEX} \
        "flagtree===${FLAGTREE_VERSION}"

# Build the FlagGems master snapshot that was validated on H100 and H20.
#
# A proxy, when required by the build host, is accepted only as the optional
# BuildKit secret `git_proxy`; it is scoped to git fetch and is never stored in
# an image layer. Example:
#   docker build --secret id=git_proxy,env=GIT_PROXY ...
#
# This FlagGems revision imports flag_gems.fused.DSA but does not include an
# __init__.py for that directory. Add the marker before building so the DSA
# modules are included in the wheel generated by setuptools.find_packages().
# Build in a throwaway venv to keep its setuptools constraints out of the
# SGLang runtime, then install the wheel with --no-deps so the official
# PyTorch/SGLang stack remains unchanged.
ARG FLAGGEMS_REF=8ea592557659491930ebf24c24392f958b29ac21
ARG FLAGGEMS_BUILD_VERSION=5.3.6.dev0+g8ea5925
# SQLAlchemy is the only FlagGems runtime dependency missing from the official
# SGLang image. The verifier checks the base image's existing NumPy, packaging,
# and PyYAML versions without replacing them.
RUN --mount=type=secret,id=git_proxy,required=false \
    set -eu; \
    git init -q /tmp/FlagGems; \
    git -C /tmp/FlagGems remote add origin https://github.com/flagos-ai/FlagGems.git; \
    if [ -s /run/secrets/git_proxy ]; then \
        git -C /tmp/FlagGems \
            -c http.proxy="$(cat /run/secrets/git_proxy)" \
            fetch --depth 1 origin "${FLAGGEMS_REF}"; \
    else \
        git -C /tmp/FlagGems fetch --depth 1 origin "${FLAGGEMS_REF}"; \
    fi; \
    git -C /tmp/FlagGems checkout -q --detach FETCH_HEAD; \
    test "$(git -C /tmp/FlagGems rev-parse HEAD)" = "${FLAGGEMS_REF}"; \
    touch /tmp/FlagGems/src/flag_gems/fused/DSA/__init__.py; \
    python3 -m venv /tmp/flaggems-build; \
    /tmp/flaggems-build/bin/pip install --no-cache-dir \
        --index-url ${PYPI_INDEX} \
        "setuptools<77" "setuptools-scm>=8,<10" wheel; \
    mkdir -p /tmp/flaggems-wheel; \
    SETUPTOOLS_SCM_PRETEND_VERSION=${FLAGGEMS_BUILD_VERSION} \
        /tmp/flaggems-build/bin/pip wheel \
        --no-deps --no-build-isolation \
        --wheel-dir /tmp/flaggems-wheel /tmp/FlagGems; \
    python3 -m pip install --no-cache-dir \
        --index-url ${PYPI_INDEX} \
        "sqlalchemy==2.0.48"; \
    python3 -m pip install --no-cache-dir --no-deps \
        /tmp/flaggems-wheel/flag_gems-*.whl; \
    rm -rf /tmp/FlagGems /tmp/flaggems-build /tmp/flaggems-wheel

# Keep the build-time and CI-time checks in one script. This fails the image
# build if a dependency resolver or stale base tag silently restores the old
# SGLang, Triton, or FlagGems stack.
COPY .github/scripts/cuda/verify_environment.py /usr/local/bin/verify-sglang-fl-cuda
RUN chmod 0755 /usr/local/bin/verify-sglang-fl-cuda && \
    python3 /usr/local/bin/verify-sglang-fl-cuda

# NVIDIA uses SGLang's native NCCL path by default. FlagCX is intentionally not
# installed in the CUDA CI image; it remains an optional deployment component
# for explicit FlagCX collective or PD-disaggregation validation.

LABEL ai.flagos.sglang.version="0.5.18" \
      ai.flagos.flagtree.version="${FLAGTREE_VERSION}" \
      ai.flagos.flaggems.revision="${FLAGGEMS_REF}"

# CUDA CI uses local model mounts and synthetic random benchmark prompts. Keep
# Hugging Face offline so a test cannot become dependent on external downloads.
FROM runtime AS ci
RUN python3 -m pip install --no-cache-dir \
        --index-url ${PYPI_INDEX} \
        "pytest==9.1.1" \
        "pytest-timeout==2.4.0" && \
    python3 /usr/local/bin/verify-sglang-fl-cuda --require-ci
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

WORKDIR /workspace
