ARG SGLANG_BASE_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/lmsysorg/sglang:v0.5.18-runtime
FROM ${SGLANG_BASE_IMAGE} AS runtime

ARG FLAGTREE_VERSION=0.6.2a1
ARG FLAGTREE_INDEX=https://resource.flagos.net/repository/flagos-pypi-hosted/simple
ARG PYPI_INDEX=https://resource.flagos.net/repository/pypi-proxy/simple
ARG PIP_PROXY=

# The official runtime image owns the complete SGLang 0.5.18 dependency stack:
# PyTorch 2.13.0+cu130, sglang-kernel 0.4.6.post1, FlashInfer 0.6.17,
# transformers 5.12.1, and xgrammar 0.2.1. Do not re-resolve that environment.

# Replace PyTorch's Triton 3.7 package with the FlagTree distribution that
# provides the Triton 3.6-compatible Python module. Keep this after the SGLang
# install because dependency resolution may install Triton again.
RUN (python3 -m pip uninstall -y triton || true) && \
    (python3 -m pip uninstall -y triton || true) && \
    PIP_PROXY_OPTION="" && \
    if [ -n "${PIP_PROXY}" ]; then PIP_PROXY_OPTION="--proxy ${PIP_PROXY}"; fi && \
    python3 -m pip install --no-cache-dir \
        ${PIP_PROXY_OPTION} \
        --index-url ${FLAGTREE_INDEX} \
        "flagtree===${FLAGTREE_VERSION}"

# Build the verified FlagGems master snapshot from source.
#  - FLAGGEMS_REF is the master commit verified on 2026-09-03. Override it with
#    master to test the moving branch, then pin the resulting commit before a
#    release build.
#  - FlagGems' build requires setuptools<77. Build it in a throwaway venv so
#    torch 2.13's runtime setuptools remains untouched.
#  - The current master imports flag_gems.fused.DSA but omits that directory's
#    __init__.py. setup.py uses find_packages(), so an unpatched wheel silently
#    drops all DSA modules. Add the package marker before building.
#  - Install the wheel with --no-deps so the official SGLang/PyTorch stack is
#    unchanged; SQLAlchemy is the only missing FlagGems runtime dependency.
ARG FLAGGEMS_REF=8ea592557659491930ebf24c24392f958b29ac21
ARG FLAGGEMS_BUILD_VERSION=5.3.6.dev0+g8ea5925
ARG GITHUB_PROXY=
RUN CURL_PROXY_OPTION="" && \
    if [ -n "${GITHUB_PROXY}" ]; then CURL_PROXY_OPTION="--proxy ${GITHUB_PROXY}"; fi && \
    curl ${CURL_PROXY_OPTION} --retry 5 --retry-all-errors --connect-timeout 30 \
        -fsSL "https://codeload.github.com/flagos-ai/FlagGems/tar.gz/${FLAGGEMS_REF}" \
        -o /tmp/flaggems.tar.gz && \
    mkdir -p /tmp/FlagGems && \
    tar -xzf /tmp/flaggems.tar.gz --strip-components=1 -C /tmp/FlagGems && \
    rm /tmp/flaggems.tar.gz && \
    touch /tmp/FlagGems/src/flag_gems/fused/DSA/__init__.py && \
    python3 -m venv /tmp/flaggems-build && \
    PIP_PROXY_OPTION="" && \
    if [ -n "${PIP_PROXY}" ]; then PIP_PROXY_OPTION="--proxy ${PIP_PROXY}"; fi && \
    /tmp/flaggems-build/bin/pip install --no-cache-dir \
        ${PIP_PROXY_OPTION} --index-url ${PYPI_INDEX} \
        "setuptools<77" "setuptools-scm>=8,<10" wheel && \
    mkdir -p /tmp/flaggems-wheel && \
    SETUPTOOLS_SCM_PRETEND_VERSION=${FLAGGEMS_BUILD_VERSION} \
    /tmp/flaggems-build/bin/pip wheel --no-deps --no-build-isolation \
        --wheel-dir /tmp/flaggems-wheel /tmp/FlagGems && \
    pip install --no-cache-dir ${PIP_PROXY_OPTION} --index-url ${PYPI_INDEX} \
        "sqlalchemy==2.0.48" && \
    pip install --no-cache-dir --no-deps /tmp/flaggems-wheel/flag_gems-*.whl && \
    rm -rf /tmp/FlagGems /tmp/flaggems-build /tmp/flaggems-wheel

# sglang's benchmark (bench_offline_throughput / bench_serving) fetches the 642 MB
# ShareGPT dataset from HF even under --dataset-name random; hf-mirror.com only
# 302-redirects to HF's US CDN, which the CI runtime proxy can't pull (ReadTimeout).
# Bake it at BUILD time into a pinned HF cache, and run offline so the benchmark
# reads it locally with zero runtime network. HF_HOME is pinned because the runner
# overrides HOME=/github/home at runtime (a cache under /root would be invisible).
FROM runtime AS benchmark
ENV HF_HOME=/opt/hf-cache
RUN HF_HUB_OFFLINE=0 python -c "from huggingface_hub import hf_hub_download as d; \
    print(d('anon8231489123/ShareGPT_Vicuna_unfiltered', \
    'ShareGPT_V3_unfiltered_cleaned_split.json', repo_type='dataset'))"
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

WORKDIR /workspace
