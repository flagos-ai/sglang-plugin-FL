@@ -0,0 +1,15 @@
+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Keep DSpark decisions identical within each attention TP replica."""
+
+from sglang.srt.runtime_context import get_parallel
+
+
+def sync_speculative_decision(values):
+    parallel = get_parallel()
+    group = (
+        parallel.attn_tp_group if parallel.enable_dp_attention else parallel.tp_group
+    )
+    if group.world_size > 1:
+        group.broadcast(values, src=0)
+    return values
