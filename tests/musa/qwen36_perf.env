# S5000 TP2 optimized profile with eventfd completion removed.
# Source before launching SGLang; other historical settings are retained.
# Set model path, visible devices, interface and pinned MATE path separately.
export FLAGGEMS_ATEN_PLAN_CACHE=0
export MATE_FORCE_JIT=1
export MATE_MUSA_ARCH_LIST=3.1
export MCCL_TIMEOUT=14400
export MUSA_LAUNCH_BLOCKING=0
export OMP_NUM_THREADS=4
export SGLANG_ALLOW_OVERWRITE_LONGER_CONTEXT_LEN=1
export SGLANG_ENABLE_GDN_FIXED_METADATA_CAPTURE=0
export SGLANG_ENABLE_SPEC_V2=1
export SGLANG_FL_DIST_BACKEND=flagcx
export SGLANG_FL_FLAGOS_BLACKLIST=count_nonzero,cumsum,mm,unique,_unique2,unique_dim,unique_consecutive,copy_,index,index_put,index_put_,_index_put_impl_,mul
export SGLANG_FL_LOG_LEVEL=INFO
export SGLANG_FL_MUSA_GDN_PACKED_DECODE_NUM_WARPS=8
export SGLANG_MOE_PADDING=1
export SGLANG_MUSA_CUSTOM_AR_FUSED_RMSNORM=auto
export SGLANG_MUSA_CUSTOM_AR_GRAPH_REGISTERED_INPUT=0
export SGLANG_MUSA_CUSTOM_AR_MAX_SIZE_MB=128
export SGLANG_MUSA_DECODE_MROPE_DEVICE_POSITIONS=auto
export SGLANG_MUSA_DETERMINISTIC_MOE_COMBINE=auto
export SGLANG_MUSA_DETERMINISTIC_MOE_COMBINE_DECODE_GRAPH=off
export SGLANG_MUSA_FMHA_PREFILL_PACK_GQA=auto
export SGLANG_MUSA_FUSE_MOE_SWIGLU_EPILOGUE=1
export SGLANG_MUSA_GDN_PACKED_DECODE_NUM_WARPS=8
export SGLANG_MUSA_M16K_MOE_PREALLOCATE_DOWN_WORKSPACE=1
export SGLANG_MUSA_M4_R2_BASELINE_SCHEDULE=1
export SGLANG_MUSA_M4_W13_BN64=1
export SGLANG_MUSA_MATE_GDN=auto
export SGLANG_MUSA_MATE_GDN_PREFILL=auto
export SGLANG_MUSA_MOE_DECODE_SCHEDULE=auto
export SGLANG_MUSA_MOE_PREFILL_SCHEDULE=auto
export SGLANG_MUSA_QWEN3_5_LAST_LAYER_COMPACT_TAIL=0
export SGLANG_MUSA_SHARED_EXPERT_GATE_TAIL_FUSED=1
export SGLANG_MUSA_TOPK_SCHEDULE=auto
export SGLANG_PROFILE_V2=0
export SGLANG_SCHEDULER_METADATA_RING=0
export SGLANG_SET_CPU_AFFINITY=1
export SGLANG_USE_DEEPGEMM_BMM=0
export SGLANG_USE_MUSA_FUSED_KERNEL=1
export TOKENIZERS_PARALLELISM=false
export TORCH_COMPILE_DISABLE=1
